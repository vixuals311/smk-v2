				},
				UIT_Ctrl_InDur = InstanceInput {
					SourceOp = "UIT_Ctrl",
					Source = "InDur",
					Name = "In Duration (s)",
					Page = "Motion",
				},
				UIT_Ctrl_Stagger = InstanceInput {
