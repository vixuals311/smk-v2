					Page = "Look",
				},
				UIT_Ctrl_Blur = InstanceInput {
					SourceOp = "UIT_Ctrl",
					Source = "Blur",
					Name = "Blur At Start",
					Page = "Look",
				},
				UIT_Ctrl_HasOut = InstanceInput {
					SourceOp = "UIT_Ctrl",
					Source = "HasOut",
					Name = "Enable Out",
					Page = "Out",
				},
				UIT_Ctrl_OutOffset = InstanceInput {
					SourceOp = "UIT_Ctrl",
					Source = "OutOffset",
					Name = "Out Offset (s)",
					Page = "Out",
				},
				UIT_Ctrl_OutDur = InstanceInput {
					SourceOp = "UIT_Ctrl",
					Source = "OutDur",
					Name = "Out Duration (s)",
					Page = "Out",
				},
			},
			Outputs = {
				MainOutput1 = InstanceOutput {
					SourceOp = "UIT_Text",
					Source = "Output",
				}
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				UIT_Ctrl = Background {
					UserControls = ordered() {
						Text = {
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							TEC_Lines = 3,
							INP_Default = "SMK Text",
							ICS_ControlPage = "Text",
						},
						InDelay = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.0,
							INP_MaxScale = 5.0,
							LINKID_DataType = "Number",
							INP_Default = 0.0,
							ICS_ControlPage = "Motion",
						},
						InDur = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.0,
							INP_MaxScale = 5.0,
							LINKID_DataType = "Number",
							INP_Default = 0.5,
							ICS_ControlPage = "Motion",
							INP_MinAllowed = 0.0,
						},
						Stagger = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.0,
							INP_MaxScale = 0.5,
							LINKID_DataType = "Number",
							INP_Default = 0.04,
							ICS_ControlPage = "Motion",
						},
						Engine = {
							INP_Integer = true,
							LBLC_DropDownButton = true,
							INPID_InputControl = "ComboControl",
							CC_Custom = true,
							LINKID_DataType = "Number",
							INP_Default = 1.0,
							ICS_ControlPage = "Motion",
							{ CCS_AddString = "Ease", },
							{ CCS_AddString = "Spring", },
							{ CCS_AddString = "Bounce", },
							{ CCS_AddString = "Elastic", },
							{ CCS_AddString = "Overshoot", },
							{ CCS_AddString = "Inertia", },
						},
						Stiff = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = 1.0,
							INP_MaxScale = 1000.0,
							LINKID_DataType = "Number",
							INP_Default = 180.0,
							ICS_ControlPage = "Motion",
						},
						Damp = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.0,
							INP_MaxScale = 100.0,
							LINKID_DataType = "Number",
							INP_Default = 18.0,
							ICS_ControlPage = "Motion",
						},
						Over = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.0,
							INP_MaxScale = 5.0,
							LINKID_DataType = "Number",
							INP_Default = 1.70158,
							ICS_ControlPage = "Motion",
						},
						Fade = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.0,
							INP_MaxScale = 1.0,
							LINKID_DataType = "Number",
							INP_Default = 0.0,
							ICS_ControlPage = "Look",
						},
						SlideDist = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = -0.5,
							INP_MaxScale = 0.5,
							LINKID_DataType = "Number",
							INP_Default = 0.03,
							ICS_ControlPage = "Look",
						},
						SlideAngle = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = -360.0,
							INP_MaxScale = 360.0,
							LINKID_DataType = "Number",
							INP_Default = -90.0,
							ICS_ControlPage = "Look",
						},
						Scale = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.0,
							INP_MaxScale = 3.0,
							LINKID_DataType = "Number",
							INP_Default = 1.0,
							ICS_ControlPage = "Look",
							INP_MinAllowed = 0.01,
						},
						Rot = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = -360.0,
							INP_MaxScale = 360.0,
							LINKID_DataType = "Number",
							INP_Default = 0.0,
							ICS_ControlPage = "Look",
						},
						Blur = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.0,
							INP_MaxScale = 20.0,
							LINKID_DataType = "Number",
							INP_Default = 0.0,
							ICS_ControlPage = "Look",
						},
						HasOut = {
							INP_Integer = true,
							INPID_InputControl = "CheckboxControl",
							LINKID_DataType = "Number",
							INP_Default = 1.0,
							ICS_ControlPage = "Out",
						},
						OutOffset = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.0,
							INP_MaxScale = 5.0,
							LINKID_DataType = "Number",
							INP_Default = 0.0,
							ICS_ControlPage = "Out",
						},
						OutDur = {
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.0,
							INP_MaxScale = 5.0,
							LINKID_DataType = "Number",
							INP_Default = 0.5,
							ICS_ControlPage = "Out",
							INP_MinAllowed = 0.0,
						},
					},
					Inputs = {
						Text = Input { Value = "SMK Text", },
						InDelay = Input { Value = 0.0, },
						InDur = Input { Value = 0.5, },
						Stagger = Input { Value = 0.04, },
						Engine = Input { Value = 1.0, },
						Stiff = Input { Value = 180.0, },
						Damp = Input { Value = 18.0, },
						Over = Input { Value = 1.70158, },
						Fade = Input { Value = 0.0, },
						SlideDist = Input { Value = 0.03, },
						SlideAngle = Input { Value = -90.0, },
						Scale = Input { Value = 1.0, },
						Rot = Input { Value = 0.0, },
						Blur = Input { Value = 0.0, },
						HasOut = Input { Value = 1.0, },
						OutOffset = Input { Value = 0.0, },
						OutDur = Input { Value = 0.5, },
						TopLeftAlpha = Input { Value = 0.0, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 132 } },
				},
				UIT_Text = TextPlus {
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1, },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						Wrap = Input { Value = 1, },
						LayoutRotation = Input { Value = 1, },
						TransformRotation = Input { Value = 1, },
						Font = Input { Value = "Open Sans", },
						Style = Input { Value = "Bold", },
						Size = Input { Value = 0.08, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Red1 = Input { Value = 1.0, },
						Green1 = Input { Value = 1.0, },
						Blue1 = Input { Value = 1.0, },
						Alpha1 = Input { Value = 1.0, },
						StyledText = Input { SourceOp = "UIT_Follower", Source = "StyledText", },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				UIT_Follower = StyledTextFollower {
					Inputs = {
						Order = Input { Value = 0, },
						TransformRotation = Input { Value = 1, },
						TransformSize = Input { Value = 1, },
						Delay = Input { Expression = "UIT_Ctrl.Stagger * comp:GetPrefs(\"Comp.FrameFormat.Rate\")", },
						Text = Input { Expression = "UIT_Ctrl.Text", },
						CharacterOffset = Input { SourceOp = "UIT_Vector", Source = "Position", },
						CharacterAngleZ = Input { SourceOp = "UIT_AngleZ", Source = "Result", },
						CharacterSizeX = Input { SourceOp = "UIT_Scale", Source = "Result", },
						CharacterSizeY = Input { SourceOp = "UIT_Scale", Source = "Result", },
						Opacity1 = Input { SourceOp = "UIT_Opacity", Source = "Result", },
						SoftnessX1 = Input { SourceOp = "UIT_Blur", Source = "Result", },
						SoftnessY1 = Input { SourceOp = "UIT_Blur", Source = "Result", },
					},
					ViewInfo = OperatorInfo { Pos = { 110, 0 } },
				},
				UIT_Vector = Vector {
					Inputs = {
						Origin = Input { Value = { 0, 0 }, },
						ImageAspect = Input { Value = 1, },
						Angle = Input { Expression = "UIT_Ctrl.SlideAngle", },
						Distance = Input { SourceOp = "UIT_Dist", Source = "Result", },
					},
					ViewInfo = OperatorInfo { Pos = { 220, 0 } },
				},
				UIT_Amt = Calculation {
					Inputs = {
						FirstOperand = Input { Expression = "(function() local s=UIT_Ctrl.Text.Value local c=select(2,s:gsub(\"[^\\128-\\191]\",\"\")) local L=c-1 local d=UIT_Ctrl.Stagger local r=comp:GetPrefs(\"Comp.FrameFormat.Rate\") local t=(time-comp.RenderStart)/r local T=(comp.RenderEnd-comp.RenderStart)/r local ti=t-UIT_Ctrl.InDelay local a=1 if ti>=0 then local p=math.min(1,ti/math.max(UIT_Ctrl.InDur,0.001)) local g=UIT_Ctrl.Engine local e=p if g<0.5 then e=1-(1-p)^3 elseif g<1.5 then local k=math.max(UIT_Ctrl.Stiff,1) local w=math.sqrt(k) local z=math.min(0.999,math.max(0.05,UIT_Ctrl.Damp/(2*w))) local wd=w*math.sqrt(1-z*z) e=1-math.exp(-z*w*ti)*(math.cos(wd*ti)+z*w/wd*math.sin(wd*ti)) elseif g<2.5 then local q=p if q<0.3636 then e=7.5625*q*q elseif q<0.7273 then q=q-0.5454 e=7.5625*q*q+0.75 elseif q<0.9091 then q=q-0.8182 e=7.5625*q*q+0.9375 else q=q-0.9545 e=7.5625*q*q+0.984375 end elseif g<3.5 then if p>0 and p<1 then e=2^(-10*p)*math.sin((p-0.075)*20.944)+1 end elseif g<4.5 then local q=p-1 e=1+(UIT_Ctrl.Over+1)*q*q*q+UIT_Ctrl.Over*q*q else e=(1-math.exp(-4*p))/(1-math.exp(-4)) end a=1-e end if UIT_Ctrl.HasOut>0.5 then local po=math.min(1,math.max(0,(t-(T-UIT_Ctrl.OutOffset-UIT_Ctrl.OutDur-L*d))/math.max(UIT_Ctrl.OutDur,0.001))) a=math.min(1,a+po*po*(3-2*po)) end return a end)()", },
					},
					ViewInfo = OperatorInfo { Pos = { 330, 0 } },
				},
				UIT_Dist = Calculation {
					Inputs = {
						Operator = Input { Value = 2, },
						SecondOperand = Input { Expression = "UIT_Ctrl.SlideDist", },
						FirstOperand = Input { SourceOp = "UIT_Amt", Source = "Result", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 0 } },
				},
				UIT_PreOp = Calculation {
					Inputs = {
						Operator = Input { Value = 2, },
						SecondOperand = Input { Expression = "(1-UIT_Ctrl.Fade)", },
						FirstOperand = Input { SourceOp = "UIT_Amt", Source = "Result", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 66 } },
				},
				UIT_Opacity = Calculation {
					Inputs = {
						Operator = Input { Value = 5, },
						SecondOperand = Input { Value = 1, },
						FirstOperand = Input { SourceOp = "UIT_PreOp", Source = "Result", },
					},
					ViewInfo = OperatorInfo { Pos = { 550, 66 } },
				},
				UIT_PreScale = Calculation {
					Inputs = {
						Operator = Input { Value = 2, },
						SecondOperand = Input { Expression = "(UIT_Ctrl.Scale-1)", },
						FirstOperand = Input { SourceOp = "UIT_Amt", Source = "Result", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 132 } },
				},
				UIT_Scale = Calculation {
					Inputs = {
						SecondOperand = Input { Value = 1, },
						FirstOperand = Input { SourceOp = "UIT_PreScale", Source = "Result", },
					},
					ViewInfo = OperatorInfo { Pos = { 550, 132 } },
				},
				UIT_AngleZ = Calculation {
					Inputs = {
						Operator = Input { Value = 2, },
						SecondOperand = Input { Expression = "UIT_Ctrl.Rot", },
						FirstOperand = Input { SourceOp = "UIT_Amt", Source = "Result", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 198 } },
				},
				UIT_Blur = Calculation {
					Inputs = {
						Operator = Input { Value = 2, },
						SecondOperand = Input { Expression = "UIT_Ctrl.Blur", },
						FirstOperand = Input { SourceOp = "UIT_Amt", Source = "Result", },
					},
					ViewInfo = OperatorInfo { Pos = { 440, 264 } },
				},
			},
		},
	},
	ActiveTool = "SMK2_TextLetter"
}
