				},
				UIT_Ctrl_Fade = InstanceInput {
					SourceOp = "UIT_Ctrl",
					Source = "Fade",
					Name = "Opacity At Start",
					Page = "Look",
				},
				UIT_Ctrl_SlideDist = InstanceInput {
