				FirstOperand = Input {
					SourceOp = "Calculation1",
					Source = "Result",
				},
				Operator = Input { Value = 2, },
				SecondOperand = Input {
					Value = 1,
					Expression = "(1-UIT_Ctrl.Fade)",
				}
			},
